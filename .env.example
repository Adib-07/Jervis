# Jervis Environment Variables
# Copy this file to .env and load it into your shell before running.
# NEVER commit real credentials — .env is gitignored.

# Jervis reads the process environment directly (no automatic .env loading).
# Load with:  set -a && source .env && set +a

# Enables OpenAI chat when set. Leave empty to fall back to local Ollama.
OPENAI_API_KEY=

# OpenAI model used when OPENAI_API_KEY is set.
JARVIS_OPENAI_MODEL=gpt-4.1-mini

# Local Ollama server, used when no OpenAI key is configured.
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=llama3.2

# Directory for the SQLite database (notes and reminders).
JARVIS_DATA_DIR=.jarvis_data
